---
import { componentMap } from "@/cloudcannon/componentMap";

interface Props {
  block: {
    _type: string;
    [key: string]: any;
  };
}

const { block } = Astro.props;
const { _type, ...props } = block;
const Component = componentMap[_type];
---

{Component && (
  <section data-editable="array-item" data-component={_type} data-id={_type}>
    <Component {...props} />
  </section>
)}
